# Copy to `.env` and set your own values. `.env` is gitignored and must never be committed.
POSTGRES_USER=fse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fse

# Host port for the container. 55432 avoids clashing with other local PostgreSQL servers (5432, 5433).
FSE_DB_PORT=55432

# Optional overrides
# FSE_DB_HOST=localhost
# FSE_DATA_ROOT=~/Documents/data-sc
