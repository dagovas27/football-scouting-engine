# Copy to `.env` and set your own values. `.env` is gitignored and must never be committed.
POSTGRES_USER=fse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fse

# Host port for the container. 5433 avoids clashing with a native PostgreSQL on 5432.
FSE_DB_PORT=5433

# Optional overrides
# FSE_DB_HOST=localhost
# FSE_DATA_ROOT=~/Documents/data-sc
